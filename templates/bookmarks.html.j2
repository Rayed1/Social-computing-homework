{% extends "base.html.j2" %}
{% from "macros/user_macros.html.j2" import user_display %}

{% block title %}Bookmarks - Mini Social{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="text-center mb-4">
        <h2>🔖 My Bookmarks</h2>
        <p class="text-muted">Posts you've saved for later</p>
    </div>
    
    <div class="col-md-8 mx-auto">
        {% if posts %}
            {% for post_data in posts %}
                {% set post = post_data.post %}
                {% set reactions = post_data.reactions %}
                {% set comments = post_data.comments %}
                
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-2">
                                    <a href="{{ url_for('user_profile', username=post.username) }}" class="text-decoration-none">
                                        {{ user_display(post.username) }}
                                    </a>
                                </h5>
                                
                                <a href="{{ url_for('post_detail', post_id=post.id) }}" class="text-decoration-none text-dark">
                                    <p class="card-text">{{ post.content }}</p>
                                </a>
                                
                                <small class="text-muted">{{ post.created_at|datetimeformat }}</small>
                            </div>
                            
                            {% if session.user_id %}
                            <form method="POST" action="{{ url_for('unbookmark_post', post_id=post.id) }}" style="display:inline;">
                                <button type="submit" class="btn btn-warning btn-sm" title="Remove bookmark">
                                    🔖 Saved
                                </button>
                            </form>
                            {% endif %}
                        </div>
                        
                        <!-- Reactions section -->
                        <div class="mt-3">
                            {% if reactions %}
                                {% for reaction in reactions %}
                                    <span class="badge bg-light text-dark me-1">{{ reaction_emojis[reaction.reaction_type] }} {{ reaction.count }}</span>
                                {% endfor %}
                            {% else %}
                                <span class="text-muted small">No reactions yet</span>
                            {% endif %}
                        </div>
                        
                        <!-- Comments preview -->
                        {% if comments %}
                            <div class="mt-3">
                                <small class="text-muted">💬 {{ comments|length }} comment(s)</small>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="alert alert-info text-center">
                <h5>📭 No bookmarks yet</h5>
                <p class="mb-0">Start exploring and bookmark posts you want to save for later!</p>
                <a href="{{ url_for('feed') }}" class="btn btn-primary mt-3">Go to Feed</a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}